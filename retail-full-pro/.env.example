# ─────────────────────────────────────────────────────────────────
# Retail Agents — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────

# Gemini API keys — automatically tries each configured key when one is rate-limited
# Get yours FREE at: https://aistudio.google.com/app/apikey
# The assistant lets the user select an available Flash model.
GEMINI_API_KEY=your_first_gemini_api_key_here
GEMINI_API_KEY_2=your_second_gemini_api_key_here
# Optional: continue with GEMINI_API_KEY_3, GEMINI_API_KEY_4, etc. as needed.
GEMINI_MODEL=gemini-2.5-flash

# Store password (protects import & clear data actions)
# Default: pius@1  — change this to your own secure password
STORE_PASSWORD=pius@1

# Flask settings
FLASK_DEBUG=true
PORT=5000
